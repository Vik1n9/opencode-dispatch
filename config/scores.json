{
  "_about": "Score table for opencode-dispatch. Scores belong to a model version, never expire, and are only added to. One entry per model: aliases = the opencode IDs that point to the same model version; scores keys = benchmark names with version (e.g. Terminal-Bench 2.1 and 2.0 are not comparable); source = vendor (vendor-reported or relayed) or independent (third-party measurement) — when a benchmark has an independent result, it wins. Category mapping is in categories. internal.<category> of each model is the internal score (from this setup's own dispatch history, computed by oc-track.mjs, weighted 2x external benchmarks); the raw track record is track.jsonl in the same folder and is not read routinely.",
  "categories": {
    "repo-coding": {
      "label": "Fix bugs / add features in an existing codebase",
      "benchmarks": [
        "DeepSWE v1.1",
        "SWE-bench Pro",
        "SWE-bench Verified"
      ]
    },
    "terminal": {
      "label": "Terminal work, running tests, environment setup, scripts",
      "benchmarks": [
        "Terminal-Bench 2.1",
        "Terminal-Bench 2.0"
      ]
    },
    "greenfield": {
      "label": "New projects from scratch, large refactors",
      "benchmarks": [
        "NL2Repo-Bench",
        "ProgramBench"
      ]
    },
    "tools": {
      "label": "Multi-step tool calling, chaining APIs",
      "benchmarks": [
        "Toolathlon-Verified",
        "PinchBench"
      ]
    },
    "gui-vision": {
      "label": "Reading screenshots, operating GUIs",
      "benchmarks": [
        "OSWorld-Verified",
        "MMMU"
      ]
    },
    "reasoning": {
      "label": "Reasoning, math, planning",
      "benchmarks": [
        "GPQA Diamond",
        "HLE"
      ]
    },
    "security": {
      "label": "Security review, finding vulnerabilities",
      "benchmarks": [
        "CyberGym"
      ]
    },
    "instruction": {
      "label": "Format-following rewrites, translation, data cleanup (mechanical work)",
      "benchmarks": [
        "IFBench",
        "IFEval"
      ]
    },
    "long-context": {
      "label": "Reading very long files or large context",
      "benchmarks": [
        "RULER",
        "MRCR"
      ]
    }
  },
